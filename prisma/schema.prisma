generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ToogleType {
  MANUAL
  LIMITCLICKS
  SCHEDULE
  TIMER
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
}

enum UserRole {
  ADMIN
}

model enterprise {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phoneNumber String   @map("phone_number")
  createAt    DateTime @map("create_at")
  updateAt    DateTime @map("update_at")

  user                       user[]
  influencer                 influencer[]
  enterpriseUrl              enterpriseUrl[]
  enterpriseToggleUrl        enterpriseToggleUrl?
  enterpriseCountDailyClicks enterpriseCountDailyClicks[]

  @@map("enterprise")
}

model user {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String
  password     String
  role         UserRole
  enterpriseId String   @map("enterprise_id") @db.Uuid
  createAt     DateTime @map("create_at")
  updateAt     DateTime @map("update_at")

  enterprise enterprise @relation(fields: [enterpriseId], references: [id])

  @@map("user")
}

model influencer {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  email          String
  password       String
  counterEntries Int      @map("counter_entries")
  personalUrl    String   @map("personal_url")
  urlImgProfile  String   @map("url_img_profile")
  imgKey         String   @map("img_key")
  enterpriseId   String   @map("enterprise_id") @db.Uuid
  createAt       DateTime @map("create_at")
  updateAt       DateTime @map("update_at")

  enterprise                 enterprise                   @relation(fields: [enterpriseId], references: [id])
  influencerPlatformUrl      influencerPlatformUrl[]
  influencerCountDailyClicks influencerCountDailyClicks[]

  @@map("influencer")
}

model influencerPlatformUrl {
  id           String   @id @default(uuid()) @db.Uuid
  url          String
  platform     Platform
  influencerId String   @map("influencer_id") @db.Uuid
  createAt     DateTime @map("create_at")
  updateAt     DateTime @map("update_at")

  influencer influencer @relation(fields: [influencerId], references: [id])

  @@map("influencer_platform_url")
}

model influencerCountDailyClicks {
  id            String   @id @default(uuid()) @db.Uuid
  dailyClicks   Int      @map("daily_clicks")
  referenceDate DateTime @map("reference_date") @db.Date
  influencerId  String   @map("influencer_id") @db.Uuid
  createAt      DateTime @map("create_at")
  updateAt      DateTime @map("update_at")

  influencer influencer @relation(fields: [influencerId], references: [id])

  @@map("influencer_count_daily_clicks")
}

model enterpriseUrl {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  url            String
  countClicks    Int      @map("count_clicks")
  active         Boolean
  order          Int
  inRotationPool Boolean  @map("in_rotation_pool")
  enterpriseId   String   @map("enterprise_id") @db.Uuid
  createAt       DateTime @map("create_at")
  updateAt       DateTime @map("update_at")

  enterprise        enterprise          @relation(fields: [enterpriseId], references: [id])
  toggleUrlSchedule toggleUrlSchedule[]

  @@map("enterprise_url")
}

model toggleUrlSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  enterpriseUrlId String   @map("enterprise_url_id") @db.Uuid
  dateTime        DateTime @map("date_time")
  updateAt        DateTime @map("update_at")

  enterpriseUrl enterpriseUrl @relation(fields: [enterpriseUrlId], references: [id])

  @@map("toggle_url_schedule")
}

model enterpriseToggleUrl {
  id             String     @id @default(uuid()) @db.Uuid
  toggleType     ToogleType @map("toggle_type")
  limitClicks    Int        @map("limit_clicks")
  timerInMinutes Int        @map("timer_in_minutes")
  enterpriseId   String     @unique @map("enterprise_id") @db.Uuid
  updateAt       DateTime   @map("update_at")

  enterprise enterprise @relation(fields: [enterpriseId], references: [id])

  @@map("enterprise_toggle_url")
}

model enterpriseCountDailyClicks {
  id            String   @id @default(uuid()) @db.Uuid
  dailyClicks   Int      @map("daily_clicks")
  referenceDate DateTime @map("reference_date") @db.Date
  enterpriseId  String   @map("enterprise_id") @db.Uuid
  createAt      DateTime @map("create_at")
  updateAt      DateTime @map("update_at")

  enterprise enterprise @relation(fields: [enterpriseId], references: [id])

  @@map("enterprise_count_daily_clicks")
}
